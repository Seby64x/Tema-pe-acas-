<!DOCTYPE html>
<html lang="ro">
<head>
<meta charset="UTF-8">
<title>Layout simplu</title>
<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: black;
  }

  header {
    background: yellow;
    padding: 20px;
    text-align: center;
    border-radius: 15px;
    margin: 10px;
  }

  .container {
    display: flex;
    margin: 10px;
  }

  nav {
    background: orange;
    width: 150px;
    padding: 20px;
    border-radius: 15px;
    writing-mode: vertical-rl;
    text-align: center;
  }

  main {
    background: #b7c99a;
    flex: 1;
    margin-left: 10px;
    padding: 20px;
    border-radius: 15px;
  }

  article {
    background: #9fd0d3;
    margin: 15px 0;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
  }

  footer {
    background: #c79acb;
    padding: 20px;
    text-align: center;
    border-radius: 15px;
    margin: 10px;
  }
</style>
</head>

<body>

<header>
  &lt;header&gt;
</header>

<div class="container">
  <nav>
    &lt;nav&gt;
  </nav>

  <main>
    &lt;main&gt;

    <article>&lt;article&gt;</article>
    <article>&lt;article&gt;</article>
    <article>&lt;article&gt;</article>

  </main>
</div>

<footer>
  &lt;footer&gt;
</footer>

</body>
</html>
